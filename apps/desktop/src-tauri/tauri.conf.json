{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xengineer",
  "version": "0.1.0",
  "identifier": "com.xengineer.voice",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "xengineer",
        "width": 460,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
