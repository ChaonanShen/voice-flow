{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voice-flow",
  "version": "0.1.0",
  "identifier": "com.voiceflow.voice",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "voice-flow",
        "width": 96,
        "height": 106,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
