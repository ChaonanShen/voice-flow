# voice-flow 环境变量示例
# 复制本文件为 .env 并填上真实 key。.env 已在 .gitignore，不会入库。
#
# 用法：
#   cp .env.example .env
#   编辑 .env 填上你的 key
#
# 程序读取顺序（优先级从高到低）：
#   1. 系统 keyring（桌面端设置面板写入，Step 9 之后）
#   2. 进程环境变量（直接 export 或 source .env）
#   3. .env 文件（CLI / 开发时方便）
#
# Day 1 阶段只用 .env / 环境变量，桌面 keyring 在 Day 2 引入。

# ============================================================================
# AI 改写层 LLM provider keys
# ============================================================================

# DeepSeek（默认 provider，国产、便宜、OpenAI 兼容）
# 申请：https://platform.deepseek.com/api_keys
# 端点：https://api.deepseek.com/v1
# 推荐模型：deepseek-chat（V3 系列，通用对话/改写）
#          deepseek-reasoner（R1，推理强，但延迟高、贵，改写场景不需要）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DashScope（备选，阿里云百炼，与 Step 8 云端 ASR 复用同一个 key）
# 申请：https://dashscope.console.aliyun.com/apiKey
# 端点 OpenAI 兼容：https://dashscope.aliyuncs.com/compatible-mode/v1
# 推荐模型：qwen-plus（性价比） / qwen-max（最强）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic（可选，Claude Opus 等顶配，最贵）
# 申请：https://console.anthropic.com/settings/keys
# 推荐模型：claude-opus-4-7
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI（可选）
# 申请：https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
